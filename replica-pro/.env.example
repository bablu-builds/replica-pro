# RMAO Configuration
# Copy this file to .env and fill in real values

# Mode: mock | real
RMAO_MODE=mock

# LLM Provider: openai | deepseek | kimi | glm
RMAO_LLM_PROVIDER=openai
RMAO_LLM_MODEL=gpt-4o-mini
RMAO_LLM_TIMEOUT=60
RMAO_LLM_MAX_RETRIES=3

# LLM API Keys (never commit these)
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
GLM_API_KEY=

# GitHub Configuration
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO_PREFIX=rmao

# Concurrency & Limits
RMAO_MAX_CONCURRENCY=4
RMAO_TASK_TIMEOUT=300
RMAO_MAX_TASKS=4

# Worker / Execution
RMAO_WORKER_COUNT=4
RMAO_EXECUTION_PROVIDER=mock

# Logging
RMAO_LOG_LEVEL=INFO
RMAO_LOG_REDACT_SECRETS=true
