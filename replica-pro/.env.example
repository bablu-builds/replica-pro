# RMAO Configuration
# Copy this file to .env and fill in real values

# Mode: mock | dry_run | real
RMAO_MODE=mock

# LLM Provider: fake | openai | deepseek | kimi | glm
RMAO_LLM_PROVIDER=fake
RMAO_LLM_MODEL=gpt-4o-mini
RMAO_LLM_TIMEOUT=60
RMAO_LLM_MAX_RETRIES=3
RMAO_LLM_BASE_URL=

# LLM API Keys (never commit these)
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
GLM_API_KEY=

# GitHub Configuration
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPOSITORY=
GITHUB_API_URL=https://api.github.com
GITHUB_BASE_BRANCH=main
GITHUB_REPO_PREFIX=rmao
GITHUB_CREATE_PULL_REQUESTS=true
GITHUB_MERGE_PULL_REQUESTS=false

# Concurrency & Limits
RMAO_MAX_CONCURRENCY=4
RMAO_TASK_TIMEOUT=300
RMAO_MAX_TASKS=4

# Worker / Execution
RMAO_WORKER_COUNT=4
RMAO_EXECUTION_PROVIDER=mock
RMAO_WORKSPACE_DIR=.
RMAO_MOCK_DELAY_MS=0

# Logging
RMAO_LOG_LEVEL=INFO
RMAO_LOG_REDACT_SECRETS=true
